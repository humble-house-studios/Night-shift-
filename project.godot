; NIGHT SHIFT - a talk-only story game split off from Look Busy: the same
; PS1 office after hours, new people, one night, 11:58 PM to 6:00 AM.
; Scaling rule (same as Look Busy): 720x1280 base, canvas_items + expand.
; Phones lock to portrait, desktop opens 1280x720, the UI switches by shape.

config_version=5

[application]

config/name="Night Shift"
run/main_scene="res://scenes/story/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override.pc=1280
window/size/window_height_override.pc=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.04, 1)
limits/spatial_indexer/threaded_cull_minimum_instances=1000000
